--!strict
-- Enemy definitions. If ServerStorage.EnemyModels.<id> exists, that model is used;
-- otherwise EnemyService builds a blocky placeholder from size/color.

export type BossPhase = {
	atHealthPct: number, -- phase starts when health drops below this (0-1)
	spawnAdds: { [string]: number }?, -- enemyId -> count
	speedMult: number?,
	damageMult: number?,
	message: string?,
}

export type EnemyDef = {
	id: string,
	name: string,
	faction: string,
	health: number,
	speed: number,
	damage: number,
	attackType: "Melee" | "Ranged",
	attackRange: number,
	attackCooldown: number,
	aggroRange: number,
	xp: number,
	size: number, -- scale of placeholder body
	color: Color3,
	isBoss: boolean?,
	phases: { BossPhase }?,
	-- Ranged enemies with a projectile fire dodgeable shots instead of instant hits
	projectile: { speed: number, size: number }?,
	-- Telegraphed special attack: a warning circle appears under the target, then explodes
	special: { every: number, radius: number, damage: number, windup: number }?,
}

-- Typed helper so each phase literal is checked on its own (Luau can't unify mixed literal shapes in an array)
local function P(phase: BossPhase): BossPhase
	return phase
end

